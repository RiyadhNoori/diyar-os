#!/bin/sh
# =============================================================================
# Diyar OS — live-build master configuration
# auto/config
# =============================================================================
set -e

# ISO volume label — set ISO_VOLUME in the environment before calling lb config
# e.g. export ISO_VOLUME="DIYAR_OS_2025.05.10" in the workflow
ISO_VOLUME="${ISO_VOLUME:-DIYAR_OS}"

# Compression: live-build supports gzip, bzip2, lzo, lzma, xz (not zstd)
# Use XZ_OPT="-T0" in environment for parallel threads (much faster)
ISO_COMPRESSION="${ISO_COMPRESSION:-xz}"

lb config noauto \
    --architectures          amd64 \
    --distribution           bookworm \
    --archive-areas          "main contrib non-free non-free-firmware" \
    --binary-images          iso-hybrid \
    --iso-application        "Diyar OS" \
    --iso-publisher          "Diyar OS Project" \
    --iso-volume             "${ISO_VOLUME}" \
    --bootappend-live        "boot=live components quiet noplymouth noeject nomodeset locales=ar_IQ.UTF-8 keyboard-layouts=ara,us timezone=Asia/Baghdad hostname=diyar-live username=diyar" \
    --bootappend-live-failsafe "boot=live components quiet noplymouth noeject nomodeset acpi=off noapic locales=ar_IQ.UTF-8 keyboard-layouts=ara,us timezone=Asia/Baghdad hostname=diyar-live username=diyar" \
    --mirror-bootstrap       "http://deb.debian.org/debian/" \
    --mirror-chroot          "https://deb.debian.org/debian/" \
    --mirror-binary          "https://deb.debian.org/debian/" \
    --mirror-chroot-security "https://security.debian.org/debian-security/" \
    --mirror-binary-security "https://security.debian.org/debian-security/" \
    --apt                    apt \
    --apt-options            "--yes" \
    --apt-recommends         false \
    --compression            "${ISO_COMPRESSION}" \
    --chroot-filesystem      squashfs \
    --debootstrap-options    "--keyring=/usr/share/keyrings/debian-archive-keyring.gpg" \
    --memtest                none \
    --zsync                  false \
    "${@}"
